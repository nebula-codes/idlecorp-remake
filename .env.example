DATABASE_URL=postgres://idlecorp:idlecorp@localhost:5432/idlecorp
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
# HTTPS and production default to secure cookies. Only override for loopback HTTP.
# COOKIE_SECURE=false
# Enable only behind a trusted reverse proxy.
TRUST_PROXY=false
SEASON_START=2026-10-01T00:00:00Z
SEASON_END=2027-01-01T00:00:00Z
# Automatic consistent backups run inside the shared server process.
BACKUP_ENABLED=true
BACKUP_DIR=.runtime/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
