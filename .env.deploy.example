# Copy to .env.deploy, then use:
# docker compose --env-file .env.deploy -f compose.deploy.yaml up -d
IDLECORP_IMAGE=ghcr.io/nebula-codes/idlecorp-remake:latest

POSTGRES_DB=idlecorp
POSTGRES_USER=idlecorp
# Replace before first start. Single quotes keep dollar signs literal in Compose.
# Credentials are passed as separate PG* values, so URL-reserved characters work.
POSTGRES_PASSWORD='replace-with-a-long-random-password'

# Bind port 3001 on the Docker host. PostgreSQL is not published to the host.
HOST_BIND=0.0.0.0
HOST_PORT=3001
# Set this to the exact browser-facing URL, for example http://192.168.1.50:3001.
# Multiple approved browser origins can be comma-separated, with no spaces.
PUBLIC_ORIGIN=http://localhost:3001
# Explicit false permits session cookies over local/LAN HTTP.
# For an HTTPS reverse proxy, set PUBLIC_ORIGIN=https://your-host and COOKIE_SECURE=true.
COOKIE_SECURE=false
# Enable only when the game server is reached exclusively through a trusted proxy.
TRUST_PROXY=false

BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
